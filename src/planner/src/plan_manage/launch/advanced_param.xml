<launch>
    <arg name="map_size_x_" />
    <arg name="map_size_y_" />
    <arg name="map_size_z_" />

    <arg name="odometry_topic" />
    <arg name="depth_topic" />
    <arg name="cloud_topic" />
    <arg name="sensing_horizon" />
    <arg name="fov_horizontal_deg" default="90.0" />
    <arg name="fov_vertical_deg" default="60.0" />

    <arg name="cx" default="321.04638671875" />
    <arg name="cy" default="243.44969177246094" />
    <arg name="fx" default="387.229248046875" />
    <arg name="fy" default="387.229248046875" />

    <arg name="flight_type" />
    <arg name="thresh_replan" />
    <arg name="thresh_no_replan" />

    <arg name="target_z" />
    <arg name="model_select_file" />

    <!-- main node -->
    <node pkg="plan_manage" name="planner_node" type="planner_node" output="screen">
        <remap from="/odom_world" to="$(arg odometry_topic)" />
        <remap from="/grid_map/odom" to="$(arg odometry_topic)" />
        <remap from="/grid_map/cloud" to="$(arg cloud_topic)" />
        <remap from="/grid_map/depth" to="$(arg depth_topic)" />

        <remap from="~plan_manage/odom" to="$(arg odometry_topic)" />
        <remap from="~plan_manage/cloud" to="$(arg cloud_topic)" />

        <!-- planning fsm -->
        <param name="fsm/flight_type" value="$(arg flight_type)" type="int" />
        <param name="fsm/thresh_replan" value="$(arg thresh_replan)" type="double" />
        <param name="fsm/thresh_no_replan" value="$(arg thresh_no_replan)" type="double" />

        <param name="fsm/target_z" value="$(arg target_z)" type="double" />

        <param name="grid_map/resolution" value="0.1" />
        <param name="grid_map/map_size_x" value="$(arg map_size_x_)" />
        <param name="grid_map/map_size_y" value="$(arg map_size_y_)" />
        <param name="grid_map/map_size_z" value="$(arg map_size_z_)" />
        <param name="grid_map/local_update_range_x" value="5.5" />
        <param name="grid_map/local_update_range_y" value="5.5" />
        <param name="grid_map/local_update_range_z" value="4.5" />
        <param name="grid_map/obstacles_inflation" value="0.1" />
        <param name="grid_map/cloud_fov_enabled" value="true" />
        <param name="grid_map/cloud_fov_range" value="$(arg sensing_horizon)" />
        <param name="grid_map/cloud_fov_horizontal_deg" value="$(arg fov_horizontal_deg)" />
        <param name="grid_map/cloud_fov_vertical_deg" value="$(arg fov_vertical_deg)" />
        <param name="grid_map/local_map_margin" value="30" />
        <param name="grid_map/ground_height" value="-0.01" />

        <param name="grid_map/cx" value="$(arg cx)" />
        <param name="grid_map/cy" value="$(arg cy)" />
        <param name="grid_map/fx" value="$(arg fx)" />
        <param name="grid_map/fy" value="$(arg fy)" />

        <param name="grid_map/use_depth_filter" value="true" />
        <param name="grid_map/depth_filter_tolerance" value="0.15" />
        <param name="grid_map/depth_filter_maxdist" value="5.0" />
        <param name="grid_map/depth_filter_mindist" value="0.2" />
        <param name="grid_map/depth_filter_margin" value="1" />
        <param name="grid_map/k_depth_scaling_factor" value="1000.0" />
        <param name="grid_map/skip_pixel" value="2" />

        <param name="grid_map/p_hit" value="0.65" />
        <param name="grid_map/p_miss" value="0.35" />
        <param name="grid_map/p_min" value="0.12" />
        <param name="grid_map/p_max" value="0.90" />
        <param name="grid_map/p_occ" value="0.80" />
        <param name="grid_map/min_ray_length" value="0.1" />
        <param name="grid_map/max_ray_length" value="4.5" />

        <param name="grid_map/virtual_ceil_height" value="6" />
        <param name="grid_map/visualization_truncate_height" value="6" />
        <param name="grid_map/show_occ_time" value="false" />
        <param name="grid_map/pose_type" value="2" />
        <param name="grid_map/frame_id" value="world" />

        <!-- planner manager -->
        <param name="manager/depthCloudStackNum" value="1" type="int" />
        <param name="manager/sampleSize" value="666" type="int" />
        <param name="manager/pcd_range_limit" value="$(arg sensing_horizon)"/>
        <param name="manager/pcd_vertical_deg" value="$(arg fov_vertical_deg)"/>
        <param name="manager/pcd_horizontal_deg" value="$(arg fov_horizontal_deg)"/>
        <param name="manager/fixed_traj_duration" value="2.0" type="double" />

        <!-- Load the selected policy in this node's private namespace. -->
        <rosparam command="load" file="$(arg model_select_file)" />

    </node>

</launch>
